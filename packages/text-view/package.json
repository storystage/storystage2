{
  "name": "@storystage/text-view",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only text view with switchable wording (Python-like or Java-like), shared by both editors.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "harness": "vite --config harness/vite.config.ts --port 4185 --strictPort"
  },
  "dependencies": {
    "@storystage/ast": "workspace:*",
    "@storystage/editor-contract": "workspace:*",
    "@storystage/story-api": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storystage/ui": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.4"
  }
}
