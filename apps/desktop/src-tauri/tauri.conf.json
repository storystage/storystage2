{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryStage 2",
  "version": "0.1.0",
  "identifier": "org.storystage.storystage2",
  "build": {
    "frontendDist": "../../studio/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @storystage/studio dev",
    "beforeBuildCommand": "pnpm --filter @storystage/studio build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StoryStage 2",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/speech/ggml-tiny.en-q5_1.bin": "speech/ggml-tiny.en-q5_1.bin"
    }
  }
}
