{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryStage spike 1.7",
  "version": "0.1.0",
  "identifier": "org.storystage.spike.android",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "StoryStage spike 1.7" }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
