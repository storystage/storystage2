{
  "name": "storystage2",
  "private": true,
  "description": "StoryStage 2: Storyboard, Production stage, Screening room.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @storystage/studio dev",
    "build": "pnpm --filter @storystage/studio build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && node tools/repo/src/boundaries-cli.ts",
    "licences": "node tools/repo/src/licences-cli.ts",
    "notice": "node tools/repo/src/licences-cli.ts --write",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
