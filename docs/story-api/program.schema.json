        "copiedFrom": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        }
      }
    },
    "statement": {
      "oneOf": [
        {
          "$ref": "#/$defs/doInOrder"
