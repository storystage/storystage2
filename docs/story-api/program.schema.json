        {
          "$ref": "#/$defs/doTogether"
        },
        {
          "$ref": "#/$defs/count"
        },
        {
          "$ref": "#/$defs/while"
        },
        {
          "$ref": "#/$defs/forEach"
        },
        {
          "$ref": "#/$defs/eachTogether"
        },
        {
          "$ref": "#/$defs/if"
        },
        {
          "$ref": "#/$defs/local"
        },
        {
          "$ref": "#/$defs/assign"
        },
        {
          "$ref": "#/$defs/comment"
        },
        {
          "$ref": "#/$defs/call"
        },
        {
          "$ref": "#/$defs/return"
        }
      ]
    },
    "doInOrder": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
