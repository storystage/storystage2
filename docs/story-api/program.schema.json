          "const": false
        },
        "item": {
          "$ref": "#/$defs/loopItem"
        },
        "items": {
          "$ref": "#/$defs/expression"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          }
        }
      }
    },
    "if": {
      "type": "object",
