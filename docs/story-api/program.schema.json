{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storystage.org/spec/program/1/program.schema.json",
  "title": "StoryStage program",
  "type": "object",
  "required": [
    "schemaVersion",
    "types"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{5,11}$"
    },
    "name": {
      "type": "string",
      "pattern": "^\\p{L}[\\p{L}\\p{N}_]*$",
      "maxLength": 60
    },
    "textValue": {
      "type": "string",
      "maxLength": 10000
    },
    "typeRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/storyType"
        },
        {
          "$ref": "#/$defs/userType"
        },
        {
          "$ref": "#/$defs/arrayType"
        }
      ]
    },
    "storyType": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "story"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "userType": {
      "type": "object",
      "required": [
        "kind",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "user"
        },
        "type": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "arrayType": {
      "type": "object",
      "required": [
        "kind",
        "of"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "array"
        },
        "of": {
          "$ref": "#/$defs/typeRef"
        }
      }
    },
    "orNoType": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/typeRef"
        }
      ]
    },
    "callee": {
      "oneOf": [
        {
          "$ref": "#/$defs/storyCallee"
        },
        {
          "$ref": "#/$defs/userCallee"
        }
      ]
    },
    "storyCallee": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "story"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "userCallee": {
      "type": "object",
      "required": [
        "kind",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "user"
        },
        "method": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "args": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expression"
      }
    },
    "type": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "extends",
        "fields",
        "methods",
        "listeners"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "type"
        },
        "copiedFrom": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "extends": {
          "$ref": "#/$defs/typeRef"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "listeners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listener"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "type",
        "initial"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "field"
        },
        "copiedFrom": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "initial": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "returns",
        "params",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "method"
        },
        "copiedFrom": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "returns": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/typeRef"
            }
          ]
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "parameter"
        },
        "copiedFrom": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "default": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        }
      }
    },
    "listener": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "event",
        "args",
        "details",
        "params",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "listener"
        },
        "copiedFrom": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "$ref": "#/$defs/name"
        },
        "args": {
          "$ref": "#/$defs/args"
        },
        "details": {
          "$ref": "#/$defs/args"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          }
        }
      }
    },
    "loopItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "loopItem"
