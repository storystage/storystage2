    { "name": "penguin", "class": "Flyer", "item": "example/Flyer/penguin", "position": { "x": 1, "y": 0, "z": 0 } },
    { "name": "fox", "class": "Quadruped", "item": "example/Quadruped/fox", "position": { "x": -1, "y": 0, "z": 0 } }
